rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.uid == moderatorUid();
    }

    // Set this to the same UID as VITE_MODERATOR_UID in the React app.
    // After first login, copy the UID from Authentication → Users.
    function moderatorUid() {
      return 'REPLACE_WITH_MODERATOR_UID';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['member', 'moderator']
        && (request.resource.data.role == 'member' || request.auth.uid == moderatorUid());
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /concept/{docId} {
      allow read: if isSignedIn();
      allow write: if isModerator() && docId == 'current';
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isModerator();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isModerator());
        allow update: if false;
      }
    }

    match /completions/{completionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['assignmentId', 'userId', 'done', 'updatedAt'])
        && request.resource.data.done is bool
        && completionId == request.resource.data.assignmentId + '_' + request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, delete: if isModerator();
      // Moderator can update any fields; members may only toggle their own UID in rsvps.
      allow update: if isModerator()
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps'])
            && request.resource.data.title == resource.data.title
            && request.resource.data.type == resource.data.type
            && request.resource.data.date == resource.data.date
            && request.resource.data.description == resource.data.description
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && (
              (request.auth.uid in request.resource.data.rsvps
                && !(request.auth.uid in resource.data.rsvps)
                && request.resource.data.rsvps.size() == resource.data.rsvps.size() + 1)
              || (!(request.auth.uid in request.resource.data.rsvps)
                && request.auth.uid in resource.data.rsvps
                && request.resource.data.rsvps.size() == resource.data.rsvps.size() - 1)
            ));
    }
  }
}
